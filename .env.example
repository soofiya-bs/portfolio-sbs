# Public URL of the deployed site (used for SEO: canonical URLs, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Inquiry emails via Resend (https://resend.com). Leave empty to log inquiries to the console.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL="Website <hello@yourdomain.com>"
